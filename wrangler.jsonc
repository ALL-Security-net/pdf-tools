{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdf-tools",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",

  // Site estático gerado pelo Vite
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Sem isto os assets respondem ANTES do worker e o 301 do domínio direto
    // (pdf.all-security.net → Workspace) nunca roda para rotas estáticas.
    "run_worker_first": true
  },

  // Módulos LibreOffice WASM (> 25 MiB) servidos via R2
  "r2_buckets": [
    {
      "binding": "WASM",
      "bucket_name": "pdf-tools-wasm"
    }
  ],

  // Domínio oficial — sem URLs de dev/preview
  "routes": [
    {
      "pattern": "pdf.all-security.net",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,

  "observability": {
    "enabled": true
  }
}
